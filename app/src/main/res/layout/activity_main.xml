<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background">

        <!-- Imagem da Logo/Fachada -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="280dp"
            android:layout_height="227dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/fachada"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Caixa branca de fundo -->
        <View
            android:id="@+id/container_components"
            style="@style/ContainerComponents"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo" />

        <!-- Campo de E-mail -->
        <EditText
            android:id="@+id/edit_email"
            style="@style/Edit_Text"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:drawableEnd="@drawable/email"
            app:layout_constraintTop_toTopOf="@id/container_components"
            app:layout_constraintStart_toStartOf="@id/container_components"
            app:layout_constraintEnd_toEndOf="@id/container_components"
            android:layout_marginTop="30dp"/>

        <!-- Campo de Senha -->
        <EditText
            android:id="@+id/edit_senha"
            style="@style/Edit_Text"
            android:hint="Senha"
            android:inputType="textPassword"
            android:drawableEnd="@drawable/album"
            app:layout_constraintTop_toBottomOf="@+id/edit_email"
            app:layout_constraintStart_toStartOf="@id/container_components"
            app:layout_constraintEnd_toEndOf="@id/container_components" />

        <!-- Botão Entrar -->

        <!-- Link para Cadastro -->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bt_entrada"
            style="@style/button"
            android:layout_marginTop="-70dp"
            android:text="@string/entrar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/container_components" />

        <TextView
            android:id="@+id/text_tela_cadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_cadastro"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@+id/bt_entrada"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>